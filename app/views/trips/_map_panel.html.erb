<iframe
  data-trip-map-target="frame"
  width="100%"
  height="300"
  style="border:0;border-radius:10px;display:none;"
  loading="lazy"
  allowfullscreen
  referrerpolicy="no-referrer-when-downgrade"
  src="about:blank">
</iframe>

<div class="map-placeholder"
     data-trip-map-target="placeholder"
     style="min-height:300px;border-radius:10px;flex-direction:column;gap:.75rem">
  <i class="bi bi-map" style="font-size:3rem"></i>
  <p data-trip-map-target="placeholderMsg"
     style="font-size:.85rem;text-align:center;padding:0 1rem;margin:0">
    Seleccioná un campo de origen y un destino para ver la ruta.
  </p>
  <a data-trip-map-target="mapsLink"
     href="#" target="_blank" rel="noopener noreferrer"
     class="btn-pill-primary"
     style="display:none;width:auto;padding:.6rem 1.5rem">
    <i class="bi bi-truck me-1"></i> Ver ruta en Google Maps
  </a>
</div>

<div data-trip-map-target="openLinkWrap" style="display:none;margin-top:.5rem">
  <a data-trip-map-target="openLink"
     href="#" target="_blank" rel="noopener noreferrer"
     class="btn-pill-secondary">
    <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en Google Maps
  </a>
</div>
