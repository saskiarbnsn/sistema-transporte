<%= form_with(model: driver) do |form| %>
  <% if driver.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(driver.errors.count, "error") %> prohibited this driver from being saved:</h2>

      <ul>
        <% driver.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card col-4">
    <div class="card-body">
      <div class="mb-3">
        <%= form.label :name, { class: "form-label" } %>
        <%= form.text_field :name, { class: "form-control" } %>
      </div>

      <div class="mb-3">
        <%= form.label :birth_date, { class: "form-label" } %>
        <%= form.date_field :birth_date, { class: "form-control" } %>
      </div>

      <div class="mb-3">
        <%= form.label :phone_number, { class: "form-label" } %>
        <%= form.text_field :phone_number, { class: "form-control" } %>
      </div>

      <div class="mb-3">
        <%= form.label :address, { class: "form-label" } %>
        <%= form.text_field :address, { class: "form-control" } %>
      </div>

      <div class="mb-3">
        <%= form.label :cuit, { class: "form-label" } %>
        <%= form.text_field :cuit, { class: "form-control" } %>
      </div>

      <div>
        <%= form.submit "Aceptar", :class => 'btn btn-primary' %>
      </div>
    </div>
  </div>
<% end %>
