<!DOCTYPE html>
<html>
  <head>
    <title>Sistema de Transporte</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="auth-page">
    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-logo">
          <i class="bi bi-truck"></i>
          <span>Sistema de Transporte</span>
        </div>

        <% if flash[:alert] %>
          <div class="alert alert-danger alert-dismissible fade show mb-3 py-2" role="alert">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
              <%= flash[:alert] %>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>

        <% if flash[:notice] %>
          <div class="alert alert-success alert-dismissible fade show mb-3 py-2" role="alert">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-check-circle-fill flex-shrink-0"></i>
              <%= flash[:notice] %>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
