<div class="form-page"
     data-controller="field-map"
     data-field-map-api-key-value="<%= google_maps_api_key %>"
     data-field-map-readonly-value="false">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-geo-alt"></i></div>
      <h1 class="ui-form-card__title">Registrar destino</h1>
    </div>
    <div class="ui-form-card__body"><%= render "form", destination: @destination %></div>
  </div>

  <div class="map-panel">
    <input class="map-search" type="text" placeholder="Buscar ubicación..." data-field-map-target="search">
    <div class="map-canvas" data-field-map-target="canvas"></div>
    <p class="map-status" data-field-map-target="status"></p>
  </div>
</div>
