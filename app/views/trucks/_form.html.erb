<%= form_with(model: truck) do |form| %>
  <% if truck.errors.any? %>
    <div class="alert alert-danger mb-3">
      <ul class="mb-0 ps-3">
        <% truck.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ui-form-grid">
    <div>
      <%= form.label :plate, "Patente", class: "form-label" %>
      <%= form.text_field :plate, class: "form-control", placeholder: "Ej: AB234CD" %>
    </div>

    <div>
      <%= form.label :fuel, "Combustible", class: "form-label" %>
      <%= form.text_field :fuel, class: "form-control", placeholder: "Ej: Gasoil" %>
    </div>

    <div>
      <%= form.label :brand, "Marca", class: "form-label" %>
      <%= form.text_field :brand, class: "form-control", placeholder: "Ej: Scania" %>
    </div>

    <div>
      <%= form.label :model, "Modelo", class: "form-label" %>
      <%= form.text_field :model, class: "form-control", placeholder: "Ej: G410" %>
    </div>

    <div>
      <%= form.label :capacity, "Capacidad", class: "form-label" %>
      <div class="ui-input-unit">
        <%= form.number_field :capacity, class: "form-control", step: "any", min: 0, placeholder: "Ej: 30000" %>
        <span class="ui-input-unit__label">kg</span>
      </div>
    </div>

    <div>
      <%= form.label :kilometres, "Kilómetros totales", class: "form-label" %>
      <div class="ui-input-unit">
        <%= form.number_field :kilometres, class: "form-control", step: "any", min: 0 %>
        <span class="ui-input-unit__label">km</span>
      </div>
    </div>

    <div class="ui-form-grid--span-2">
      <%= form.label :service_kilometres, "Km desde último servicio", class: "form-label" %>
      <div class="ui-input-unit">
        <%= form.number_field :service_kilometres, class: "form-control", step: "any", min: 0 %>
        <span class="ui-input-unit__label">km</span>
      </div>
      <small class="text-muted mt-1 d-block">
        <i class="bi bi-info-circle me-1"></i>Alerta automática al alcanzar 20.000 km.
      </small>
    </div>
  </div>

  <div class="ui-form-actions mt-2">
    <%= form.submit truck.new_record? ? "Guardar camión" : "Actualizar camión", class: "btn-pill-primary" %>
    <%= link_to "Cancelar", trucks_path, class: "btn-pill-secondary" %>
  </div>
<% end %>
