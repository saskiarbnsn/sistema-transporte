<div class="form-page"
     data-controller="field-map"
     data-field-map-api-key-value="<%= google_maps_api_key %>"
     data-field-map-readonly-value="true">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-person-vcard"></i></div>
      <h1 class="ui-form-card__title">Detalle del chofer</h1>
    </div>
    <div class="ui-form-card__body">
      <div class="ui-form-grid">
        <div><span class="form-label d-block">CUIT</span><div class="form-control"><%= @driver.cuit %></div></div>
        <div><span class="form-label d-block">Teléfono</span><div class="form-control"><%= @driver.phone_number %></div></div>
        <div><span class="form-label d-block">Nombre</span><div class="form-control"><%= @driver.name %></div></div>
        <div><span class="form-label d-block">Domicilio</span><div class="form-control"><%= @driver.location %></div></div>
        <div><span class="form-label d-block">Fecha de nacimiento</span><div class="form-control"><%= @driver.birth_date&.strftime("%d/%m/%Y") %></div></div>
        <div><span class="form-label d-block">Apto físico</span><div class="form-control"><%= @driver.aptofisico ? "Sí" : "No" %></div></div>
        <div><span class="form-label d-block">Venc. licencia</span><div class="form-control"><%= @driver.licencia_vencimiento&.strftime("%d/%m/%Y") || "Sin fecha" %></div></div>
        <div><span class="form-label d-block">Venc. apto</span><div class="form-control"><%= @driver.apto_vencimiento&.strftime("%d/%m/%Y") || "Sin fecha" %></div></div>
      </div>
      <%= hidden_field_tag :latitude,  @driver.latitude,  data: { "field-map-target": "latitude" } %>
      <%= hidden_field_tag :longitude, @driver.longitude, data: { "field-map-target": "longitude" } %>
      <div class="ui-form-actions">
        <%= link_to "Editar", edit_driver_path(@driver), class: "btn-pill-primary" %>
        <%= link_to "Volver", drivers_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <div class="map-panel">
    <div class="map-canvas" data-field-map-target="canvas"></div>
    <p class="map-status" data-field-map-target="status"></p>
  </div>
</div>
