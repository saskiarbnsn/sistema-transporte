<% trips = Trip.where(destination_id: @destination.id).includes(:field, :driver, :truck).order(date: :desc).limit(50) %>

<div class="form-page">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-building-fill"></i></div>
      <div>
        <h1 class="ui-form-card__title"><%= @destination.name %></h1>
        <p style="margin:0;font-size:0.8rem;color:#888;">CUIT <%= @destination.cuit %></p>
      </div>
    </div>
    <div class="ui-form-card__body">

      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Nombre</span>
          <span class="detail-value"><%= @destination.name %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">CUIT</span>
          <span class="detail-value"><%= @destination.cuit %></span>
        </div>
        <div class="detail-item detail-item--full">
          <span class="detail-label">Ubicación</span>
          <span class="detail-value"><%= @destination.location.presence || "—" %></span>
        </div>
      </div>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_destination_path(@destination), class: "btn-pill-primary" %>
        <%= link_to "Volver", destinations_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <%= render "trips/related_trips", trips: trips %>
</div>
