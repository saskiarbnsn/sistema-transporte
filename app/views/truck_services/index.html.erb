<div class="dash-panel">
  <div class="dash-panel__header">
    <h1 class="dash-panel__title">
      <i class="bi bi-wrench"></i>
      Servicios — <%= @truck.plate %>
      <span class="dash-count"><%= @services.size %></span>
    </h1>
    <div class="d-flex gap-2">
      <%= link_to truck_path(@truck), class: "btn-pill-secondary", style: "width:auto;padding:.5rem 1.25rem;font-size:.85rem" do %>
        <i class="bi bi-arrow-left me-1"></i> Volver al camión
      <% end %>
      <button class="btn-pill-primary"
              style="width:auto;padding:.5rem 1.25rem;font-size:.85rem"
              data-bs-toggle="modal"
              data-bs-target="#serviceModal">
        <i class="bi bi-plus-lg me-1"></i> Registrar servicio
      </button>
    </div>
  </div>

  <table class="dash-table">
    <thead>
      <tr>
        <th data-sortable style="cursor:pointer;user-select:none">Fecha <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">Km al momento <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th>Observaciones</th>
        <th class="dash-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @services.each do |svc| %>
        <tr class="dash-table__row" onclick="window.location='<%= truck_truck_service_path(@truck, svc) %>'" style="cursor:pointer">
          <td style="white-space:nowrap">
            <strong><%= svc.service_date.strftime("%d/%m/%Y") %></strong>
          </td>
          <td>
            <% km = svc.kilometres_at_service.to_f %>
            <span class="status-badge <%= km > 0 ? 'status-badge--neutral' : 'status-badge--ok' %>">
              <%= number_with_delimiter(km.to_i) %> km
            </span>
          </td>
          <td style="color:#666"><%= svc.notes.presence || "—" %></td>
          <td class="dash-table__actions" onclick="event.stopPropagation()">
            <div class="d-flex gap-1 justify-content-end">
              <%= link_to edit_truck_truck_service_path(@truck, svc),
                    class: "dash-action dash-action--edit",
                    title: "Editar" do %>
                <i class="bi bi-pencil-fill"></i>
              <% end %>
              <%= button_to truck_truck_service_path(@truck, svc), method: :delete,
                    class: "dash-action dash-action--delete",
                    title: "Eliminar",
                    form: { data: { turbo_confirm: "¿Eliminar este registro de servicio?" }, style: "display:inline-flex" } do %>
                <i class="bi bi-trash-fill"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @services.empty? %>
        <tr>
          <td colspan="4" class="text-center py-4">
            <i class="bi bi-wrench" style="font-size:2rem;color:#ccc;display:block;margin-bottom:.5rem"></i>
            <span class="text-muted" style="font-size:.875rem">Sin servicios registrados.</span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# ── Modal registrar servicio ──────────────────────────────── %>
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
    <div class="modal-content renew-modal">
      <div class="renew-modal__header">
        <div class="renew-modal__icon renew-modal__icon--truck"><i class="bi bi-wrench"></i></div>
        <div>
          <h5 class="renew-modal__title">Registrar servicio</h5>
          <p class="renew-modal__sub">Camión <%= @truck.plate %></p>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
      </div>
      <div class="renew-modal__body">
        <form method="post" action="<%= reset_service_truck_path(@truck) %>" data-turbo="false">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="_method" value="patch">
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceDate">Fecha del servicio</label>
            <input type="date" id="serviceDate" name="service_date"
                   class="form-control gasto-input" required
                   value="<%= Date.today %>"
                   style="border-radius:12px">
          </div>
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceSupplier">Proveedor</label>
            <input type="text" id="serviceSupplier" name="supplier"
                   class="form-control gasto-input"
                   placeholder="Ej: Taller Mecánico López"
                   style="border-radius:12px">
          </div>
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceDescription">Concepto / Descripción</label>
            <input type="text" id="serviceDescription" name="description"
                   class="form-control gasto-input" required
                   placeholder="Ej: Cambio de aceite y filtros"
                   style="border-radius:12px">
          </div>
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceTotal">Importe ($)</label>
            <input type="number" id="serviceTotal" name="total"
                   class="form-control gasto-input" required
                   min="0" step="0.01" placeholder="0.00"
                   style="border-radius:12px">
          </div>
          <button type="submit" class="btn-pill-primary">
            <i class="bi bi-check-lg me-1"></i>Confirmar servicio
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
