<div id="<%= dom_id driver %>">
  <p><strong>Nombre:</strong> <%= driver.name %></p>
  <p><strong>CUIT:</strong> <%= driver.cuit %></p>
  <p><strong>Teléfono:</strong> <%= driver.phone_number %></p>
  <p><strong>Domicilio:</strong> <%= driver.location %></p>
  <p><strong>Fecha de nacimiento:</strong> <%= driver.birth_date&.strftime("%d/%m/%Y") %></p>
</div>
