<%
  field       = @trip.field
  destination = @trip.destination
  can_map     = field.present? && destination.present?

  if can_map
    origin_param = if field.latitude && field.longitude
      "#{field.latitude},#{field.longitude}"
    else
      CGI.escape([field.name, field.province].compact.join(", "))
    end

    dest_param = if destination.latitude && destination.longitude
      "#{destination.latitude},#{destination.longitude}"
    else
      CGI.escape([destination.name, destination.location].compact.join(", "))
    end

    google_maps_url  = "https://www.google.com/maps/dir/?api=1&origin=#{origin_param}&destination=#{dest_param}&travelmode=driving"
    embed_src        = "https://www.google.com/maps/embed/v1/directions?key=#{ENV['GOOGLE_MAPS_API_KEY']}&origin=#{origin_param}&destination=#{dest_param}&mode=driving&language=es"
  end
%>

<div class="form-page">

  <%# ── Columna izquierda: datos del viaje ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-map"></i></div>
      <h1 class="ui-form-card__title">Detalle del viaje</h1>
    </div>
    <div class="ui-form-card__body">
      <div class="ui-form-grid">
        <div>
          <span class="form-label d-block">Origen</span>
          <div class="form-control"><%= @trip.field&.name || @trip.customer&.name %></div>
        </div>
        <div>
          <span class="form-label d-block">Destino</span>
          <div class="form-control"><%= @trip.destination&.name %></div>
        </div>
        <div>
          <span class="form-label d-block">Chofer</span>
          <div class="form-control"><%= @trip.driver&.name %></div>
        </div>
        <div>
          <span class="form-label d-block">Camión</span>
          <div class="form-control"><%= @trip.truck&.plate %></div>
        </div>
        <div>
          <span class="form-label d-block">Producto</span>
          <div class="form-control"><%= @trip.product %></div>
        </div>
        <div>
          <span class="form-label d-block">Peso (Kg)</span>
          <div class="form-control"><%= @trip.weight %></div>
        </div>
        <div>
          <span class="form-label d-block">Tarifa</span>
          <div class="form-control"><%= @trip.tariff %> $/t</div>
        </div>
        <div>
          <span class="form-label d-block">Kilómetros</span>
          <div class="form-control"><%= @trip.kilometres %></div>
        </div>
        <div>
          <span class="form-label d-block">Neto</span>
          <div class="form-control">$&thinsp;<%= number_with_delimiter(@trip.net.to_f.round(2)) %></div>
        </div>
        <div>
          <span class="form-label d-block">Importe con IVA (21%)</span>
          <div class="form-control" style="font-weight:700;color:#3b5bdb">
            $&thinsp;<%= number_with_delimiter(@trip.importeiva.to_f.round(2)) %>
          </div>
        </div>
        <div>
          <span class="form-label d-block">Fecha de inicio</span>
          <div class="form-control"><%= @trip.date&.strftime("%d/%m/%Y") || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Fecha de finalización</span>
          <div class="form-control d-flex align-items-center gap-2">
            <% if @trip.date_end.present? && @trip.date_end > Date.today %>
              <%= @trip.date_end.strftime("%d/%m/%Y") %>
              <span class="status-badge status-badge--warning ms-1">
                <i class="bi bi-clock me-1"></i>En viaje hasta esa fecha
              </span>
            <% elsif @trip.date_end.present? %>
              <span class="status-badge status-badge--ok">
                <i class="bi bi-check-circle-fill me-1"></i><%= @trip.date_end.strftime("%d/%m/%Y") %>
              </span>
            <% else %>
              <span class="status-badge status-badge--warning">
                <i class="bi bi-truck me-1"></i>En viaje
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <% if @trip.factura.attached? || @trip.carta_de_porte.attached? %>
        <div class="mt-3">
          <span class="form-label d-block mb-2">Archivos adjuntos</span>
          <div class="d-flex gap-2 flex-wrap">
            <% if @trip.factura.attached? %>
              <%= link_to rails_blob_path(@trip.factura, disposition: "attachment"),
                    class: "file-upload-btn file-upload-btn--chosen" do %>
                <i class="bi bi-file-earmark-arrow-down"></i> Factura
              <% end %>
            <% end %>
            <% if @trip.carta_de_porte.attached? %>
              <%= link_to rails_blob_path(@trip.carta_de_porte, disposition: "attachment"),
                    class: "file-upload-btn file-upload-btn--chosen" do %>
                <i class="bi bi-file-earmark-arrow-down"></i> Carta de Porte
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_trip_path(@trip), class: "btn-pill-primary" %>
        <%= link_to "Volver al historial", trips_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <%# ── Columna derecha: mapa de ruta ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-truck"></i></div>
      <h2 class="ui-form-card__title">Ruta del viaje</h2>
    </div>
    <div class="ui-form-card__body" style="padding: 0.75rem 0.75rem 1rem;">

      <% if can_map %>
        <% if ENV['GOOGLE_MAPS_API_KEY'].present? %>
          <iframe
            width="100%"
            height="480"
            style="border:0; border-radius:10px; display:block;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src="<%= embed_src %>">
          </iframe>
          <div class="mt-2">
            <%= link_to google_maps_url, target: "_blank", rel: "noopener noreferrer", class: "btn-pill-secondary" do %>
              <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en Google Maps
            <% end %>
          </div>
        <% else %>
          <div class="map-placeholder" style="min-height:460px; border-radius:10px; flex-direction:column; gap:1rem;">
            <i class="bi bi-map" style="font-size:3.5rem;"></i>
            <p style="font-size:0.85rem; text-align:center; padding:0 1.5rem; margin:0;">
              Configurá <code>GOOGLE_MAPS_API_KEY</code> en <code>.env</code> para ver la ruta embebida.
            </p>
            <%= link_to google_maps_url, target: "_blank", rel: "noopener noreferrer",
                class: "btn-pill-primary", style: "width:auto; padding:0.6rem 1.5rem;" do %>
              <i class="bi bi-truck me-1"></i> Ver ruta en Google Maps
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="map-placeholder" style="min-height:460px; border-radius:10px; flex-direction:column; gap:0.75rem;">
          <i class="bi bi-geo-alt" style="font-size:3.5rem;"></i>
          <p style="font-size:0.85rem; text-align:center; padding:0 1rem; margin:0;">
            Asigná un campo de origen y un destino al viaje para ver la ruta.
          </p>
        </div>
      <% end %>

    </div>
  </div>

</div>
