<div class="dash-panel">
  <div class="dash-panel__header">
    <h1 class="dash-panel__title">
      <i class="bi bi-people"></i>
      Clientes
      <span class="dash-count"><%= @customers.size %></span>
    </h1>
    <%= link_to new_customer_path, class: "btn-pill-primary", style: "width:auto;padding:.5rem 1.25rem;font-size:.85rem" do %>
      <i class="bi bi-plus-lg me-1"></i> Nuevo cliente
    <% end %>
  </div>

  <table class="dash-table">
    <thead>
      <tr>
        <th data-sortable style="cursor:pointer;user-select:none">Nombre <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">CUIT <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">Campos <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th class="dash-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr class="dash-table__row" onclick="window.location='<%= customer_path(customer) %>'" style="cursor:pointer">
          <td><strong><%= customer.name %></strong></td>
          <td><%= customer.cuit %></td>
          <td>
            <span class="dash-count"><%= customer.fields.count %></span>
          </td>
          <td class="dash-table__actions">
            <div class="d-flex gap-1 justify-content-end">
              <%= link_to edit_customer_path(customer),
                    class: "dash-action dash-action--edit",
                    title: "Editar",
                    onclick: "event.stopPropagation()" do %>
                <i class="bi bi-pencil-fill"></i>
              <% end %>
              <%= button_to customer_path(customer), method: :delete,
                    class: "dash-action dash-action--delete",
                    title: "Eliminar",
                    form: { data: { turbo_confirm: "¿Eliminar este cliente?" }, style: "display:inline-flex" },
                    onclick: "event.stopPropagation()" do %>
                <i class="bi bi-trash-fill"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @customers.empty? %>
        <tr>
          <td colspan="4" class="text-center py-4">
            <i class="bi bi-people" style="font-size:2rem;color:#ccc;display:block;margin-bottom:.5rem"></i>
            <span class="text-muted" style="font-size:.875rem">No hay clientes cargados todavía.</span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
