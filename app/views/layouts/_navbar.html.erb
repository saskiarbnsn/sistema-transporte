<aside class="app-sidebar" data-shell-target="sidebar">
  <div class="app-sidebar__header">
    <button class="app-sidebar__toggle" type="button"
            data-action="click->shell#toggle" aria-label="Abrir menú">
      <i class="bi bi-list"></i>
    </button>
    <span class="app-sidebar__menu-label">Menú</span>
  </div>

  <nav class="app-sidebar__nav">
    <%= link_to root_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'homes'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Inicio" } do %>
      <i class="bi bi-house"></i>
      <span class="app-sidebar__label">Inicio</span>
    <% end %>

    <%= link_to drivers_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'drivers'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Chofer" } do %>
      <i class="bi bi-person-vcard"></i>
      <span class="app-sidebar__label">Chofer</span>
    <% end %>

    <%= link_to trucks_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'trucks'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Camión" } do %>
      <i class="bi bi-truck"></i>
      <span class="app-sidebar__label">Camión</span>
    <% end %>

    <%= link_to customers_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'customers'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Cliente" } do %>
      <i class="bi bi-people"></i>
      <span class="app-sidebar__label">Cliente</span>
    <% end %>

    <%= link_to destinations_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'destinations'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Destino" } do %>
      <i class="bi bi-geo-alt"></i>
      <span class="app-sidebar__label">Destino</span>
    <% end %>

    <%= link_to fields_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'fields'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Campo" } do %>
      <i class="bi bi-sign-turn-slight-right"></i>
      <span class="app-sidebar__label">Campo</span>
    <% end %>

    <div class="app-sidebar__divider"></div>

    <%= link_to trips_path,
        class: "app-sidebar__item #{'is-active' if controller_name == 'trips' && action_name == 'index'}",
        data: { bs_toggle: "tooltip", bs_placement: "right", bs_title: "Historial" } do %>
      <i class="bi bi-clock-history"></i>
      <span class="app-sidebar__label">Historial</span>
    <% end %>
  </nav>

  <div class="app-sidebar__footer">
    <%= link_to destroy_user_session_path,
        class: "app-sidebar__item app-sidebar__item--muted",
        data: { turbo_method: :delete, bs_toggle: "tooltip", bs_placement: "right", bs_title: "Cerrar sesión" } do %>
      <i class="bi bi-box-arrow-left"></i>
      <span class="app-sidebar__label">Cerrar sesión</span>
    <% end %>
  </div>
</aside>
