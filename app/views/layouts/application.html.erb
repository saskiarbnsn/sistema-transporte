<!DOCTYPE html>
<html>
  <head>
    <title>Tesis</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
  <p class="navbar-text float-right">
    <% if user_signed_in? %>
      Hola <strong><%= current_user.email %></strong>.
      <%= button_to "Cerrar Sesion", destroy_user_session_path, method: :delete, :class => 'navbar-link'  %>
    <% else %>
      <%= link_to "Registrarse", new_user_registration_path, :class => 'navbar-link'  %> |
      <%= link_to "Iniciar Sesion", new_user_session_path, :class => 'navbar-link'  %>
    <% end %>
  </p>
  <div id="drivers" class="container mt-4">
    <% if notice %>
      <p class="alert alert-success"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="alert alert-danger"><%= alert %></p>
    <% end %>
    <%= yield %>
    </div>
  </body>
</html>
