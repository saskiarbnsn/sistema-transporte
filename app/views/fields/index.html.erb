<div class="dash-panel">
  <div class="dash-panel__header">
    <h1 class="dash-panel__title">
      <i class="bi bi-geo-alt-fill"></i>
      Campos
      <span class="dash-count"><%= @fields.size %></span>
    </h1>
    <%= link_to new_field_path, class: "btn-pill-primary", style: "width:auto;padding:.5rem 1.25rem;font-size:.85rem" do %>
      <i class="bi bi-plus-lg me-1"></i> Nuevo campo
    <% end %>
  </div>

  <table class="dash-table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Provincia</th>
        <th>Cliente</th>
        <th>Coordenadas</th>
        <th class="dash-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @fields.each do |field| %>
        <tr class="dash-table__row" onclick="window.location='<%= field_path(field) %>'" style="cursor:pointer">
          <td><strong><%= field.name %></strong></td>
          <td><%= field.province %></td>
          <td><%= field.customer&.name %></td>
          <td>
            <% if field.latitude && field.longitude %>
              <span class="status-badge status-badge--ok"><i class="bi bi-pin-map-fill me-1"></i>Ubicado</span>
            <% else %>
              <span class="status-badge status-badge--neutral">Sin ubicación</span>
            <% end %>
          </td>
          <td class="dash-table__actions">
            <div class="d-flex gap-1 justify-content-end">
              <%= link_to edit_field_path(field),
                    class: "dash-action dash-action--edit",
                    title: "Editar",
                    onclick: "event.stopPropagation()" do %>
                <i class="bi bi-pencil-fill"></i>
              <% end %>
              <%= button_to field_path(field), method: :delete,
                    class: "dash-action dash-action--delete",
                    title: "Eliminar",
                    form: { data: { turbo_confirm: "¿Eliminar este campo?" }, style: "display:inline-flex" },
                    onclick: "event.stopPropagation()" do %>
                <i class="bi bi-trash-fill"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @fields.empty? %>
        <tr>
          <td colspan="5" class="text-center py-4">
            <i class="bi bi-geo-alt" style="font-size:2rem;color:#ccc;display:block;margin-bottom:.5rem"></i>
            <span class="text-muted" style="font-size:.875rem">No hay campos cargados todavía.</span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
