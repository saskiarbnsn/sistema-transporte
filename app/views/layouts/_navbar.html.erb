<div class="d-flex flex-column h-100 bg-light">
  <div class="sidebar-brand border-bottom">
    <div class="sidebar-brand border-bottom">
    <span class="fw-bold fs-5 px-3 py-3 d-block">Tesis</span>
  </div>

  <ul class="nav nav-pills flex-column mb-auto pt-3">
    <li class="nav-item">
      <%= link_to homes_path, class: "nav-link text-dark sidebar-link" do %>
        <i class="bi bi-house sidebar-menu-icon"></i>
        <span class="sidebar-label">Inicio</span>
      <% end %>
    </li>

    <li>
      <%= link_to drivers_path, class: "nav-link text-dark sidebar-link" do %>
        <i class="bi bi-person-vcard sidebar-menu-icon"></i>
        <span class="sidebar-label">Choferes</span>
      <% end %>
    </li>

    <li>
      <%= link_to trucks_path, class: "nav-link text-dark sidebar-link" do %>
        <i class="bi bi-truck sidebar-menu-icon"></i>
        <span class="sidebar-label">Camiones</span>
      <% end %>
    </li>

    <li>
      <%= link_to destinations_path, class: "nav-link text-dark sidebar-link" do %>
        <i class="bi bi-geo-alt sidebar-menu-icon"></i>
        <span class="sidebar-label">Destinos</span>
      <% end %>
    </li>

    <li>
      <%= link_to customers_path, class: "nav-link text-dark sidebar-link" do %>
        <i class="bi bi-people sidebar-menu-icon"></i>
        <span class="sidebar-label">Clientes</span>
      <% end %>
    </li>
  </ul>

  <div class="sidebar-user mt-auto border-top d-flex flex-column align-items-center justify-content-center py-3">
    <div class="user-box d-flex align-items-center gap-2 w-100 px-3 mb-3">
      <i class="bi bi-person-circle sidebar-menu-icon"></i>
      <span class="sidebar-label user-email text-truncate">
        <%= current_user.email %>
      </span>
    </div>

    <%= button_to destroy_user_session_path,
        method: :delete,
        class: "logout-btn d-flex align-items-center justify-content-center gap-2" do %>
      <i class="bi bi-box-arrow-right sidebar-menu-icon"></i>
      <span class="sidebar-label logout-text">Cerrar sesión</span>
    <% end %>
  </div>
</div>