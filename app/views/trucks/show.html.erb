<div class="form-page">

  <%# ── Columna izquierda: datos del camión ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-truck-front-fill"></i></div>
      <h1 class="ui-form-card__title">Detalle del camión</h1>
    </div>
    <div class="ui-form-card__body">

      <div class="ui-form-grid">
        <div>
          <span class="form-label d-block">Patente</span>
          <div class="form-control"><%= @truck.plate %></div>
        </div>
        <div>
          <span class="form-label d-block">Combustible</span>
          <div class="form-control"><%= @truck.fuel.presence || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Marca</span>
          <div class="form-control"><%= @truck.brand.presence || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Modelo</span>
          <div class="form-control"><%= @truck.model.presence || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Capacidad</span>
          <div class="form-control">
            <%= @truck.capacity ? "#{number_with_delimiter(@truck.capacity.to_i)} kg" : "—" %>
          </div>
        </div>
        <div>
          <span class="form-label d-block">Kilómetros totales</span>
          <div class="form-control">
            <%= @truck.kilometres ? "#{number_with_delimiter(@truck.kilometres.to_i)} km" : "—" %>
          </div>
        </div>
        <div class="ui-form-grid--span-2">
          <span class="form-label d-block">Km desde último servicio</span>
          <% svc = @truck.service_kilometres.to_f %>
          <div class="form-control d-flex align-items-center gap-2">
            <%= number_with_delimiter(svc.to_i) %> km
            <% if svc >= 20_000 %>
              <button class="status-badge status-badge--danger ms-2"
                      data-bs-toggle="modal"
                      data-bs-target="#serviceModal"
                <i class="bi bi-wrench me-1"></i>Servicio requerido
              </button>
            <% elsif svc >= 15_000 %>
              <span class="status-badge status-badge--warning ms-2">
                <i class="bi bi-exclamation-triangle me-1"></i>Próximo a servicio
              </span>
            <% else %>
              
            <% end %>
          </div>
        </div>
      </div>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_truck_path(@truck), class: "btn-pill-primary" %>
        <%= link_to "Volver", trucks_path, class: "btn-pill-secondary" %>
      </div>

    </div>
  </div>

  <%# ── Columna derecha: historial servicios + viajes ── %>
  <div style="display:flex;flex-direction:column;gap:1rem">

    <div class="dash-panel" data-controller="table-sort">
      <div class="dash-panel__header">
        <%= link_to truck_truck_services_path(@truck) do %>
        <h2 class="dash-panel__title">
          <i class="bi bi-wrench"></i>
          Historial de servicios
          <span class="dash-count"><%= @services.size %></span>
        </h2>
        <% end %>
        <div class="d-flex gap-2">
          <button class="btn-pill-primary"
                  style="width:auto;padding:.5rem 1.25rem;font-size:.85rem"
                  data-bs-toggle="modal"
                  data-bs-target="#serviceModal">
            <i class="bi bi-plus-lg me-1"></i> Agregar servicio
          </button>
        </div>
      </div>

      <% if @services.any? %>
        <table class="dash-table">
          <thead>
            <tr>
              <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Fecha <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
              <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Km al momento <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
              <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Proveedor <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
              <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Concepto <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
              <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Importe <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
              <th class="dash-table__actions"></th>
            </tr>
          </thead>
          <tbody>
            <% @services.each do |svc| %>
              <% gasto = @maintenance_gastos[svc.service_date] %>
              <tr class="dash-table__row" onclick="window.location='<%= truck_truck_service_path(@truck, svc) %>'" style="cursor:pointer">
                <td style="white-space:nowrap">
                  <strong><%= svc.service_date.strftime("%d/%m/%Y") %></strong>
                </td>
                <td>
                  <% km = svc.kilometres_at_service.to_f %>
                  <span class="status-badge <%= km > 0 ? 'status-badge--neutral' : 'status-badge--ok' %>">
                    <%= number_with_delimiter(km.to_i) %> km
                  </span>
                </td>
                <td><%= gasto&.supplier.presence || "—" %></td>
                <td><%= gasto&.description.presence || "—" %></td>
                <td><%= gasto&.total ? "$ #{number_with_delimiter(gasto.total.to_i)}" : "—" %></td>
                <td class="dash-table__actions" onclick="event.stopPropagation()">
                  <div class="d-flex gap-1 justify-content-end">
                    <%= link_to edit_truck_truck_service_path(@truck, svc),
                          class: "dash-action dash-action--edit",
                          title: "Editar" do %>
                      <i class="bi bi-pencil-fill"></i>
                    <% end %>
                    <%= button_to truck_truck_service_path(@truck, svc), method: :delete,
                          class: "dash-action dash-action--delete",
                          title: "Eliminar",
                          form: { data: { turbo_confirm: "¿Eliminar este registro de servicio?" }, style: "display:inline-flex" } do %>
                      <i class="bi bi-trash-fill"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-center py-4">
          <i class="bi bi-wrench" style="font-size:2rem;color:#ccc;display:block;margin-bottom:.5rem"></i>
          <span class="text-muted" style="font-size:.875rem">Sin servicios registrados.</span>
        </div>
      <% end %>
    </div>

    <%= render "trips/panel", trips: @trips %>

  </div>

</div>

<%# ── Modal registrar servicio ── %>
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:360px">
    <div class="modal-content renew-modal">
      <div class="renew-modal__header">
        <div class="renew-modal__icon renew-modal__icon--truck"><i class="bi bi-wrench"></i></div>
        <div>
          <h5 class="renew-modal__title">Registrar servicio</h5>
          <p class="renew-modal__sub">Camión <%= @truck.plate %></p>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
      </div>
      <div class="renew-modal__body">
        <form method="post" action="<%= reset_service_truck_path(@truck) %>" data-turbo="false">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="_method" value="patch">
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceDate">Fecha del servicio</label>
            <input type="date" id="serviceDate" name="service_date"
                   class="form-control gasto-input" required
                   value="<%= Date.today %>"
                   style="border-radius:12px">
          </div>
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceSupplier">Proveedor</label>
            <input type="text" id="serviceSupplier" name="supplier"
                   class="form-control gasto-input"
                   placeholder="Ej: Taller Mecánico López"
                   style="border-radius:12px">
          </div>
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceDescription">Concepto / Descripción</label>
            <input type="text" id="serviceDescription" name="description"
                   class="form-control gasto-input" required
                   placeholder="Ej: Cambio de aceite y filtros"
                   style="border-radius:12px">
          </div>
          <div class="mb-3">
            <label class="gasto-label mb-1" for="serviceTotal">Importe ($)</label>
            <input type="number" id="serviceTotal" name="total"
                   class="form-control gasto-input" required
                   min="0" step="0.01" placeholder="0.00"
                   style="border-radius:12px">
          </div>
          <button type="submit" class="btn-pill-primary">
            <i class="bi bi-check-lg me-1"></i>Confirmar servicio
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
