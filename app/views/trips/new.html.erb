<% fields_data       = Field.all.map       { |f| { id: f.id, latitude: f.latitude, longitude: f.longitude, name: f.name, province: f.province } } %>
<% destinations_data = Destination.all.map { |d| { id: d.id, latitude: d.latitude, longitude: d.longitude, name: d.name, location: d.location } } %>

<div data-controller="trip-map trip-calc"
     data-trip-map-api-key-value="<%= ENV['GOOGLE_MAPS_API_KEY'] %>"
     data-trip-map-fields-value="<%= fields_data.to_json %>"
     data-trip-map-destinations-value="<%= destinations_data.to_json %>">

  <%= form_with model: @trip, multipart: true do |form| %>
    <div class="form-page">

      <%# ── Columna izquierda: campos del formulario ── %>
      <div class="ui-form-card">
        <div class="ui-form-card__header">
          <div class="ui-form-card__badge"><i class="bi bi-map"></i></div>
          <h1 class="ui-form-card__title">Cargar viaje</h1>
        </div>
        <div class="ui-form-card__body">
          <%= render "form", trip: @trip, form: form %>
        </div>
      </div>

      <%# ── Columna derecha ── %>
      <div style="display:flex;flex-direction:column;gap:1rem">

        <%# Mapa %>
        <div class="ui-form-card">
          <div class="ui-form-card__header">
            <div class="ui-form-card__badge"><i class="bi bi-truck"></i></div>
            <h2 class="ui-form-card__title">Ruta del viaje</h2>
          </div>
          <div class="ui-form-card__body" style="padding:.75rem .75rem 1rem">
            <%= render "trips/map_panel" %>
          </div>
        </div>

        <%# Panel de cálculo %>
        <div class="trip-calc-panel">
          <div class="trip-calc-row">
            <span class="trip-calc-row__label">Tarifa</span>
            <span class="trip-calc-row__value" data-trip-calc-target="tariffDisplay">—</span>
          </div>
          <hr style="margin:.1rem 0;border-color:#eee">
          <div class="trip-calc-row">
            <span class="trip-calc-row__label">Neto</span>
            <span class="trip-calc-row__value" data-trip-calc-target="netDisplay">—</span>
          </div>
          <div class="trip-calc-row trip-calc-row--total">
            <span class="trip-calc-row__label">Importe con IVA (21%)</span>
            <span class="trip-calc-row__value" data-trip-calc-target="ivaDisplay">—</span>
          </div>
        </div>

        <%# Archivos + Acciones %>
        <div class="ui-form-card">
          <div class="ui-form-card__body">
            <p class="form-label mb-2">Adjuntar archivos</p>
            <div class="d-flex gap-2 mb-3">
              <label class="file-upload-btn flex-fill"
                     data-default-label="Factura">
                <i class="bi bi-upload"></i>
                <span data-filename>Factura</span>
                <%= form.file_field :factura, class: "visually-hidden",
                      accept: ".pdf,.jpg,.jpeg,.png",
                      data: { action: "change->trip-calc#fileChosen" } %>
              </label>
              <label class="file-upload-btn flex-fill"
                     data-default-label="Carta de Porte">
                <i class="bi bi-upload"></i>
                <span data-filename>Carta de Porte</span>
                <%= form.file_field :carta_de_porte, class: "visually-hidden",
                      accept: ".pdf,.jpg,.jpeg,.png",
                      data: { action: "change->trip-calc#fileChosen" } %>
              </label>
            </div>
            <%= form.submit "Continuar", class: "btn-pill-primary w-100" %>
            <%= link_to "Cancelar", trips_path, class: "btn-pill-secondary w-100 text-center mt-2 d-block" %>
          </div>
        </div>

      </div><%# /right column %>
    </div><%# /form-page %>
  <% end %>

</div>
