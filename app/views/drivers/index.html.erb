<div class="dash-panel">
  <div class="dash-panel__header">
    <h1 class="dash-panel__title">
      <i class="bi bi-person-vcard"></i>
      Choferes
      <span class="dash-count"><%= @drivers.size %></span>
    </h1>
    <%= link_to new_driver_path, class: "btn-pill-primary", style: "width:auto;padding:.5rem 1.25rem;font-size:.85rem" do %>
      <i class="bi bi-plus-lg me-1"></i> Nuevo chofer
    <% end %>
  </div>

  <table class="dash-table">
    <thead>
      <tr>
        <th data-sortable style="cursor:pointer;user-select:none">Nombre <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">CUIT <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">Teléfono <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">Apto físico <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th data-sortable style="cursor:pointer;user-select:none">Venc. licencia <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        <th class="dash-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% today = Date.current %>
      <% @drivers.each do |driver| %>
        <tr class="dash-table__row" onclick="window.location='<%= driver_path(driver) %>'" style="cursor:pointer">
          <td><strong><%= driver.name %></strong></td>
          <td><%= driver.cuit %></td>
          <td><%= driver.phone_number %></td>

          <%# — Apto físico —%>
          <td onclick="event.stopPropagation()">
            <% if driver.apto_vencimiento.nil? %>
              <button class="status-badge status-badge--neutral"
                      data-bs-toggle="modal"
                      data-bs-target="#aptoModal"
                      data-driver-id="<%= driver.id %>"
                      data-driver-name="<%= driver.name %>"
                      data-driver-has-apto="<%= driver.aptofisico ? '1' : '0' %>">Sin fecha</button>
            <% elsif driver.apto_vencimiento < today %>
              <button class="status-badge status-badge--danger"
                      data-bs-toggle="modal"
                      data-bs-target="#aptoModal"
                      data-driver-id="<%= driver.id %>"
                      data-driver-name="<%= driver.name %>"
                      data-driver-has-apto="<%= driver.aptofisico ? '1' : '0' %>">Vencido</button>
            <% elsif driver.apto_vencimiento <= today + 30 %>
              <button class="status-badge status-badge--warning"
                      data-bs-toggle="modal"
                      data-bs-target="#aptoModal"
                      data-driver-id="<%= driver.id %>"
                      data-driver-name="<%= driver.name %>"
                      data-driver-has-apto="<%= driver.aptofisico ? '1' : '0' %>">Vence <%= driver.apto_vencimiento.strftime("%d/%m/%Y") %></button>
            <% else %>
              <span class="status-badge status-badge--ok">Vigente</span>
            <% end %>
          </td>

          <%# — Licencia —%>
          <td onclick="event.stopPropagation()">
            <% if driver.licencia_vencimiento.nil? %>
              <button class="status-badge status-badge--neutral"
                      data-bs-toggle="modal"
                      data-bs-target="#licenciaModal"
                      data-driver-id="<%= driver.id %>"
                      data-driver-name="<%= driver.name %>">Sin fecha</button>
            <% elsif driver.licencia_vencimiento < today %>
              <button class="status-badge status-badge--danger"
                      data-bs-toggle="modal"
                      data-bs-target="#licenciaModal"
                      data-driver-id="<%= driver.id %>"
                      data-driver-name="<%= driver.name %>">Vencida</button>
            <% elsif driver.licencia_vencimiento <= today + 30 %>
              <button class="status-badge status-badge--warning"
                      data-bs-toggle="modal"
                      data-bs-target="#licenciaModal"
                      data-driver-id="<%= driver.id %>"
                      data-driver-name="<%= driver.name %>">Vence <%= driver.licencia_vencimiento.strftime("%d/%m/%Y") %></button>
            <% else %>
              <span class="status-badge status-badge--ok">Vigente</span>
            <% end %>
          </td>

          <td class="dash-table__actions">
            <div class="d-flex gap-1 justify-content-end">
              <%= link_to edit_driver_path(driver),
                    class: "dash-action dash-action--edit",
                    title: "Editar",
                    onclick: "event.stopPropagation()" do %>
                <i class="bi bi-pencil-fill"></i>
              <% end %>
              <%= button_to driver_path(driver), method: :delete,
                    class: "dash-action dash-action--delete",
                    title: "Eliminar",
                    form: { data: { turbo_confirm: "¿Eliminar este chofer?" }, style: "display:inline-flex" },
                    onclick: "event.stopPropagation()" do %>
                <i class="bi bi-trash-fill"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @drivers.empty? %>
        <tr>
          <td colspan="6" class="text-center py-4">
            <i class="bi bi-person-badge" style="font-size:2rem;color:#ccc;display:block;margin-bottom:.5rem"></i>
            <span class="text-muted" style="font-size:.875rem">No hay choferes cargados todavía.</span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# ── Modal: Apto físico ──────────────────────────────── %>
<div class="modal fade" id="aptoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:360px">
    <div class="modal-content renew-modal">
      <div class="renew-modal__header">
        <div class="renew-modal__icon"><i class="bi bi-heart-pulse"></i></div>
        <div>
          <h5 class="renew-modal__title">Apto físico</h5>
          <p class="renew-modal__sub" id="aptoDriverName"></p>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
      </div>
      <div class="renew-modal__body">
        <form id="aptoForm" method="post" data-turbo="false">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="_method" value="patch">
          <div class="mb-3">
            <label class="gasto-label mb-2">¿Tiene apto físico?</label>
            <div class="d-flex gap-4 mt-1">
              <label class="d-flex align-items-center gap-2" style="font-size:.9rem;cursor:pointer">
                <input type="radio" name="aptofisico" id="aptoSi" value="1"
                       style="width:18px;height:18px;accent-color:#3b5bdb;cursor:pointer">
                Sí
              </label>
              <label class="d-flex align-items-center gap-2" style="font-size:.9rem;cursor:pointer">
                <input type="radio" name="aptofisico" id="aptoNo" value="0"
                       style="width:18px;height:18px;accent-color:#3b5bdb;cursor:pointer">
                No
              </label>
            </div>
          </div>
          <div class="mb-3" id="aptoDateGroup">
            <label class="gasto-label mb-1" for="aptoDate">Fecha de vencimiento</label>
            <input type="date" id="aptoDate" name="renewal_date"
                   class="form-control gasto-input"
                   style="border-radius:12px">
          </div>
          <button type="submit" class="btn-pill-primary">
            <i class="bi bi-check-lg me-1"></i>Confirmar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%# ── Modal: Licencia de conducir ──────────────────────────────── %>
<div class="modal fade" id="licenciaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:360px">
    <div class="modal-content renew-modal">
      <div class="renew-modal__header">
        <div class="renew-modal__icon"><i class="bi bi-card-text"></i></div>
        <div>
          <h5 class="renew-modal__title">Licencia de conducir</h5>
          <p class="renew-modal__sub" id="licenciaDriverName"></p>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
      </div>
      <div class="renew-modal__body">
        <form id="licenciaForm" method="post" data-turbo="false">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="_method" value="patch">
          <div class="mb-3">
            <label class="gasto-label mb-1" for="licenciaDate">Nueva fecha de vencimiento</label>
            <input type="date" id="licenciaDate" name="renewal_date"
                   class="form-control gasto-input" required
                   value="<%= Date.today %>"
                   style="border-radius:12px">
          </div>
          <button type="submit" class="btn-pill-primary">
            <i class="bi bi-check-lg me-1"></i>Confirmar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('aptoModal').addEventListener('show.bs.modal', function(e) {
    var btn = e.relatedTarget;
    document.getElementById('aptoDriverName').textContent = btn.dataset.driverName;
    document.getElementById('aptoForm').action = '/drivers/' + btn.dataset.driverId + '/renew_apto';

    var hasApto = btn.dataset.driverHasApto === '1';
    document.getElementById('aptoSi').checked = hasApto;
    document.getElementById('aptoNo').checked = !hasApto;
    document.getElementById('aptoDateGroup').style.display = hasApto ? '' : 'none';
  });

  document.querySelectorAll('input[name="aptofisico"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      document.getElementById('aptoDateGroup').style.display = this.value === '1' ? '' : 'none';
    });
  });

  document.getElementById('licenciaModal').addEventListener('show.bs.modal', function(e) {
    var btn = e.relatedTarget;
    document.getElementById('licenciaDriverName').textContent = btn.dataset.driverName;
    document.getElementById('licenciaForm').action = '/drivers/' + btn.dataset.driverId + '/renew_licencia';
  });
</script>
