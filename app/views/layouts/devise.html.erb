<!DOCTYPE html>
<html>
  <head>
    <title>Sistema de Transporte</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="auth-page">
    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-logo">
          <i class="bi bi-truck"></i>
          <span>Sistema de Transporte</span>
        </div>
        <% if flash[:alert] %>
          <div class="flash-alert flash-alert--error mb-3" role="alert">
            <i class="bi bi-exclamation-circle-fill flash-alert__icon"></i>
            <span class="flash-alert__text"><%= flash[:alert] %></span>
            <button class="flash-alert__close" onclick="this.closest('.flash-alert').remove()" aria-label="Cerrar">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
