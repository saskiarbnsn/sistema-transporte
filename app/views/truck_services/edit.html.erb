<div class="gasto-page">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-wrench"></i></div>
      <h1 class="ui-form-card__title">Editar servicio — <%= @truck.plate %></h1>
    </div>
    <div class="ui-form-card__body">

      <%= form_with model: [@truck, @service], local: true, data: { controller: "gasto-form" } do |f| %>

        <div class="ui-form-grid">

          <div>
            <span class="form-label d-block">Imputación</span>
            <div class="form-control">Mantenimiento</div>
          </div>
          <div>
            <%= f.label :service_date, "Fecha del servicio", class: "form-label" %>
            <%= f.date_field :service_date, class: "form-control", required: true %>
          </div>

          <% if @gasto %>
            <div>
              <label class="form-label">Proveedor</label>
              <input type="text" name="gasto[supplier]"
                     value="<%= @gasto.supplier %>"
                     class="form-control"
                     placeholder="Ej: Taller Mecánico López">
            </div>
            <div>
              <label class="form-label">Concepto / Descripción</label>
              <input type="text" name="gasto[description]"
                     value="<%= @gasto.description %>"
                     class="form-control"
                     placeholder="Ej: Cambio de aceite y filtros">
            </div>
          <% end %>

          <div>
            <span class="form-label d-block">Camión</span>
            <div class="form-control"><%= @truck.plate %></div>
          </div>
          <div>
            <%= f.label :kilometres_at_service, "Km al momento", class: "form-label" %>
            <%= f.number_field :kilometres_at_service, class: "form-control", min: 0, step: 1 %>
          </div>

          <div class="ui-form-grid--span-2">
            <%= f.label :notes, "Observaciones", class: "form-label" %>
            <%= f.text_field :notes, class: "form-control", placeholder: "Opcional" %>
          </div>

        </div>

        <% if @gasto %>
          <div class="gasto-totals">
            <div class="gasto-totals__left">
              <p class="gasto-totals__title">Importe Total</p>
              <input type="number" name="gasto[total]"
                     value="<%= @gasto.total %>"
                     class="gasto-total-input"
                     step="0.01" min="0" placeholder="$ 0,00"
                     data-gasto-form-target="total"
                     data-action="input->gasto-form#calculate">
            </div>
            <div class="gasto-totals__breakdown">
              <div class="gasto-totals__col">
                <span class="gasto-totals__col-label">Neto</span>
                <span class="gasto-totals__col-value" data-gasto-form-target="netoDisplay">$ 0,00</span>
              </div>
              <div class="gasto-totals__sep"></div>
              <div class="gasto-totals__col">
                <span class="gasto-totals__col-label">IVA</span>
                <span class="gasto-totals__col-value" data-gasto-form-target="ivaDisplay">$ 0,00</span>
              </div>
              <div class="gasto-totals__sep"></div>
              <div class="gasto-totals__col">
                <span class="gasto-totals__col-label">Gravado</span>
                <span class="gasto-totals__col-value" data-gasto-form-target="gravadoDisplay">$ 0,00</span>
              </div>
            </div>
          </div>
        <% end %>

        <div class="ui-form-actions">
          <%= f.submit "Guardar cambios", class: "btn-pill-primary" %>
          <%= link_to "Cancelar", truck_truck_services_path(@truck), class: "btn-pill-secondary" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
