<h2 class="auth-title">Recuperar contraseña</h2>
<p class="text-muted text-center mb-4" style="font-size:0.875rem;">
  Ingresá tu email y te enviaremos instrucciones para restablecer tu contraseña.
</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="mb-4">
    <%= f.label :email, "Email", class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "form-control", placeholder: "tu@email.com" %>
  </div>

  <%= f.submit "Enviar instrucciones", class: "btn btn-primary w-100" %>
<% end %>

<div class="auth-links">
  <%= link_to "Volver al inicio de sesión", new_session_path(resource_name) %>
</div>
