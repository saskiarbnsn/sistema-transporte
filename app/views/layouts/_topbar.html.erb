<header class="app-topbar">
  <% today = Time.zone.today
     dias   = %w[Domingo Lunes Martes Miércoles Jueves Viernes Sábado]
     meses  = %w[Enero Febrero Marzo Abril Mayo Junio Julio Agosto Septiembre Octubre Noviembre Diciembre] %>
  <div class="app-topbar__date">
    <span class="app-topbar__day"><%= "#{dias[today.wday]} #{today.day}".upcase %></span>
    <span class="app-topbar__month"><%= "#{meses[today.month - 1]}, #{today.year}" %></span>
  </div>

  <div class="app-topbar__actions">
    <div class="dropdown" data-action="show.bs.dropdown->shell#clearBadge">
      <button class="app-topbar__icon-btn position-relative"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              title="Notificaciones">
        <i class="bi bi-bell"></i>
        <% if @show_notification_badge %>
          <span class="app-topbar__badge" data-shell-target="badge">
            <%= @notifications.size %>
          </span>
        <% end %>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm notification-dropdown">
        <% if @notifications&.any? %>
          <li class="dropdown-header">Alertas (<%= @notifications.size %>)</li>
          <% @notifications.each do |n| %>
            <li>
              <%= link_to(n[:entity] == :truck ? truck_path(n[:id]) : driver_path(n[:id]),
                    class: "dropdown-item notification-item d-flex align-items-start gap-2") do %>
                <span class="flex-shrink-0 d-flex align-items-center gap-1">
                  <% if n[:entity] == :truck %>
                    <i class="bi bi-truck text-secondary"></i>
                  <% else %>
                    <i class="bi bi-person-fill text-secondary"></i>
                  <% end %>
                  <% if n[:type] == :danger %>
                    <i class="bi bi-exclamation-circle-fill text-danger"></i>
                  <% else %>
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                  <% end %>
                </span>
                <span><%= n[:msg] %></span>
              <% end %>
            </li>
          <% end %>
        <% else %>
          <li><span class="dropdown-item text-muted">Sin alertas</span></li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="dropdown">
    <button class="app-topbar__user dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      <div class="app-topbar__avatar"><i class="bi bi-person-fill"></i></div>
      <span class="app-topbar__username">
        <%= current_user&.username&.presence || current_user&.email&.split("@")&.first&.split(/[._-]/)&.map(&:capitalize)&.join(" ") %>
      </span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
      <%= link_to "Cerrar sesión", destroy_user_session_path,
          class: "dropdown-item text-danger",
          data: { turbo_method: :delete } %>
    </ul>
  </div>
</header>
