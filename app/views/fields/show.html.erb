<%
  if @field.latitude && @field.longitude
    map_param = "#{@field.latitude},#{@field.longitude}"
  elsif @field.province.present?
    map_param = CGI.escape([@field.name, @field.province].compact.join(", "))
  end
%>

<div class="form-page">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-geo-alt-fill"></i></div>
      <div>
        <h1 class="ui-form-card__title"><%= @field.name %></h1>
        <p style="margin:0;font-size:0.8rem;color:#888;"><%= @field.province %></p>
      </div>
    </div>
    <div class="ui-form-card__body">

      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Nombre</span>
          <span class="detail-value"><%= @field.name %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Provincia</span>
          <span class="detail-value"><%= @field.province.presence || "—" %></span>
        </div>
        <div class="detail-item detail-item--full">
          <span class="detail-label">Propietario</span>
          <span class="detail-value"><%= @field.customer&.name || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Latitud</span>
          <span class="detail-value"><%= @field.latitude || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Longitud</span>
          <span class="detail-value"><%= @field.longitude || "—" %></span>
        </div>
      </div>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_field_path(@field), class: "btn-pill-primary" %>
        <%= link_to "Volver", fields_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-map-fill"></i></div>
      <h2 class="ui-form-card__title">Ubicación del campo</h2>
    </div>
    <div class="ui-form-card__body" style="padding:0.75rem;">
      <% if map_param && ENV['GOOGLE_MAPS_API_KEY'].present? %>
        <iframe width="100%" height="440" style="border:0;border-radius:10px;display:block;"
                loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"
                src="https://www.google.com/maps/embed/v1/place?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&q=<%= map_param %>&language=es">
        </iframe>
      <% elsif map_param %>
        <div class="map-placeholder" style="min-height:440px;border-radius:10px;flex-direction:column;gap:0.75rem;">
          <i class="bi bi-map" style="font-size:3rem;"></i>
          <%= link_to "Ver en Google Maps", "https://www.google.com/maps/search/?api=1&query=#{map_param}",
                target: "_blank", rel: "noopener noreferrer", class: "btn-pill-primary",
                style: "width:auto;padding:0.6rem 1.5rem;" %>
        </div>
      <% else %>
        <div class="map-placeholder" style="min-height:440px;border-radius:10px;flex-direction:column;gap:0.75rem;">
          <i class="bi bi-geo-alt" style="font-size:3rem;"></i>
          <p style="font-size:0.85rem;text-align:center;margin:0;color:#aaa;padding:0 1rem;">
            Editá el campo para fijar su ubicación en el mapa.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
