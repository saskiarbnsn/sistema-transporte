<%
  field       = @trip.field
  destination = @trip.destination
  can_map     = field.present? && destination.present?

  if can_map
    origin_param = if field.latitude && field.longitude
      "#{field.latitude},#{field.longitude}"
    else
      CGI.escape([field.name, field.province].compact.join(", "))
    end

    dest_param = if destination.latitude && destination.longitude
      "#{destination.latitude},#{destination.longitude}"
    else
      CGI.escape([destination.name, destination.location].compact.join(", "))
    end

    google_maps_url  = "https://www.google.com/maps/dir/?api=1&origin=#{origin_param}&destination=#{dest_param}&travelmode=driving"
    embed_src        = "https://www.google.com/maps/embed/v1/directions?key=#{ENV['GOOGLE_MAPS_API_KEY']}&origin=#{origin_param}&destination=#{dest_param}&mode=driving&language=es"
  end
%>

<div class="form-page">

  <%# ── Columna izquierda: datos del viaje ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-map"></i></div>
      <h1 class="ui-form-card__title">Detalle del viaje</h1>
    </div>
    <div class="ui-form-card__body">
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Origen</span>
          <span class="detail-value"><%= @trip.field&.name || @trip.customer&.name || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Destino</span>
          <span class="detail-value"><%= @trip.destination&.name || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Chofer</span>
          <span class="detail-value"><%= @trip.driver&.name || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Camión</span>
          <span class="detail-value"><%= @trip.truck&.plate || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Producto</span>
          <span class="detail-value"><%= @trip.product.presence || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Peso</span>
          <span class="detail-value"><%= @trip.weight ? "#{@trip.weight} Kg" : "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Tarifa ($/Kg)</span>
          <span class="detail-value"><%= @trip.tariff || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Kilómetros</span>
          <span class="detail-value"><%= @trip.kilometres ? "#{@trip.kilometres} km" : "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Neto</span>
          <span class="detail-value"><%= @trip.net ? number_to_currency(@trip.net, unit: "$", separator: ",", delimiter: ".") : "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Total con IVA (21%)</span>
          <span class="detail-value" style="font-weight:600;color:#1a1a2e;"><%= @trip.importeiva ? number_to_currency(@trip.importeiva, unit: "$", separator: ",", delimiter: ".") : "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Fecha de inicio</span>
          <span class="detail-value"><%= @trip.date&.strftime("%d/%m/%Y") || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Fecha de finalización</span>
          <span class="detail-value">
            <% if @trip.date_end %>
              <%= @trip.date_end.strftime("%d/%m/%Y") %>
            <% else %>
              <span class="status-badge status-badge--warning">En viaje</span>
            <% end %>
          </span>
        </div>
      </div>

      <% if @trip.carta_de_porte.attached? || @trip.factura.attached? %>
        <div class="detail-item detail-item--full" style="border-bottom:none; padding-bottom:0;">
          <span class="detail-label">Documentación</span>
          <div class="d-flex gap-2 flex-wrap mt-1">
            <% if @trip.carta_de_porte.attached? %>
              <%= link_to rails_blob_path(@trip.carta_de_porte, disposition: "inline"),
                    class: "doc-chip", title: @trip.carta_de_porte.filename.to_s,
                    target: "_blank", rel: "noopener noreferrer" do %>
                <i class="bi bi-file-earmark-text"></i> Carta de porte
              <% end %>
            <% end %>
            <% if @trip.factura.attached? %>
              <%= link_to rails_blob_path(@trip.factura, disposition: "inline"),
                    class: "doc-chip", title: @trip.factura.filename.to_s,
                    target: "_blank", rel: "noopener noreferrer" do %>
                <i class="bi bi-file-earmark-invoice"></i> Factura
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_trip_path(@trip), class: "btn-pill-primary" %>
        <%= link_to "Volver al historial", trips_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <%# ── Columna derecha: mapa de ruta ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-truck"></i></div>
      <h2 class="ui-form-card__title">Ruta del viaje</h2>
    </div>
    <div class="ui-form-card__body" style="padding: 0.75rem 0.75rem 1rem;">

      <% if can_map %>
        <% if ENV['GOOGLE_MAPS_API_KEY'].present? %>
          <iframe
            width="100%"
            height="480"
            style="border:0; border-radius:10px; display:block;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src="<%= embed_src %>">
          </iframe>
          <div class="mt-2">
            <%= link_to google_maps_url, target: "_blank", rel: "noopener noreferrer", class: "btn-pill-secondary" do %>
              <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en Google Maps
            <% end %>
          </div>
        <% else %>
          <div class="map-placeholder" style="min-height:460px; border-radius:10px; flex-direction:column; gap:1rem;">
            <i class="bi bi-map" style="font-size:3.5rem;"></i>
            <p style="font-size:0.85rem; text-align:center; padding:0 1.5rem; margin:0;">
              Configurá <code>GOOGLE_MAPS_API_KEY</code> en <code>.env</code> para ver la ruta embebida.
            </p>
            <%= link_to google_maps_url, target: "_blank", rel: "noopener noreferrer",
                class: "btn-pill-primary", style: "width:auto; padding:0.6rem 1.5rem;" do %>
              <i class="bi bi-truck me-1"></i> Ver ruta en Google Maps
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="map-placeholder" style="min-height:460px; border-radius:10px; flex-direction:column; gap:0.75rem;">
          <i class="bi bi-geo-alt" style="font-size:3.5rem;"></i>
          <p style="font-size:0.85rem; text-align:center; padding:0 1rem; margin:0;">
            Asigná un campo de origen y un destino al viaje para ver la ruta.
          </p>
        </div>
      <% end %>

    </div>
  </div>

</div>
