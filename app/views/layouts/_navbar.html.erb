<aside class="app-sidebar" data-shell-target="sidebar">
  <div class="app-sidebar__header">
    <button class="app-sidebar__toggle" type="button"
            data-action="click->shell#toggle"
            aria-label="Abrir menú">
      <i class="bi bi-list"></i>
    </button>
  </div>

  <nav class="app-sidebar__nav">
    <%= link_to root_path, class: "app-sidebar__item #{controller_name == 'homes' ? 'is-active' : ''}" do %>
      <i class="bi bi-house"></i>
      <span class="app-sidebar__label">Inicio</span>
    <% end %>

    <%= link_to new_driver_path, class: "app-sidebar__item #{controller_name == 'drivers' && action_name == 'new' ? 'is-active' : ''}" do %>
      <i class="bi bi-person-vcard"></i>
      <span class="app-sidebar__label">Cargar chofer</span>
    <% end %>

    <%= link_to new_truck_path, class: "app-sidebar__item #{controller_name == 'trucks' && action_name == 'new' ? 'is-active' : ''}" do %>
      <i class="bi bi-truck"></i>
      <span class="app-sidebar__label">Cargar camión</span>
    <% end %>

    <%= link_to new_customer_path, class: "app-sidebar__item #{controller_name == 'customers' && action_name == 'new' ? 'is-active' : ''}" do %>
      <i class="bi bi-people"></i>
      <span class="app-sidebar__label">Cargar cliente</span>
    <% end %>

    <%= link_to new_destination_path, class: "app-sidebar__item #{controller_name == 'destinations' && action_name == 'new' ? 'is-active' : ''}" do %>
      <i class="bi bi-geo-alt"></i>
      <span class="app-sidebar__label">Cargar destino</span>
    <% end %>

    <div class="app-sidebar__divider"></div>

    <%= link_to drivers_path, class: "app-sidebar__item #{controller_name == 'drivers' && action_name == 'index' ? 'is-active' : ''}" do %>
      <i class="bi bi-clock-history"></i>
      <span class="app-sidebar__label">Historial</span>
    <% end %>
  </nav>

  <div class="app-sidebar__footer">
    <%= link_to destroy_user_session_path, class: "app-sidebar__item app-sidebar__item--muted",
        data: { turbo_method: :delete } do %>
      <i class="bi bi-box-arrow-left"></i>
      <span class="app-sidebar__label">Cerrar sesión</span>
    <% end %>
  </div>
</aside>
