<div id="<%= dom_id driver %>">
  <p>
    <strong>Name:</strong>
    <%= driver.name %>
  </p>

  <p>
    <strong>Birth date:</strong>
    <%= driver.birth_date %>
  </p>

  <p>
    <strong>Phone number:</strong>
    <%= driver.phone_number %>
  </p>

  <p>
    <strong>Domicilio:</strong>
    <%= driver.location %>
  </p>

  <p>
    <strong>Cuit:</strong>
    <%= driver.cuit %>
  </p>

</div>
