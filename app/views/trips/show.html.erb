<%
  field       = @trip.field
  destination = @trip.destination
  can_map     = field.present? && destination.present?

  if can_map
    origin_param = if field.latitude && field.longitude
      "#{field.latitude},#{field.longitude}"
    else
      CGI.escape([field.name, field.province].compact.join(", "))
    end

    dest_param = if destination.latitude && destination.longitude
      "#{destination.latitude},#{destination.longitude}"
    else
      CGI.escape([destination.name, destination.location].compact.join(", "))
    end

    google_maps_url  = "https://www.google.com/maps/dir/?api=1&origin=#{origin_param}&destination=#{dest_param}&travelmode=driving"
    embed_src        = "https://www.google.com/maps/embed/v1/directions?key=#{ENV['GOOGLE_MAPS_API_KEY']}&origin=#{origin_param}&destination=#{dest_param}&mode=driving&language=es"
  end
%>

<div data-controller="trip-status">
<div class="form-page">

  <%# ── Columna izquierda: datos del viaje ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-map"></i></div>
      <h1 class="ui-form-card__title">Detalle del viaje</h1>
    </div>
    <div class="ui-form-card__body">
      <div class="ui-form-grid">
        <div>
          <span class="form-label d-block">Origen</span>
          <div class="form-control"><%= "#{@trip.field&.name} - #{@trip.customer&.name}" || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Destino</span>
          <div class="form-control"><%= @trip.destination&.name || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Chofer</span>
          <div class="form-control"><%= @trip.driver&.name || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Camión</span>
          <div class="form-control"><%= @trip.truck&.plate || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Producto</span>
          <div class="form-control"><%= @trip.product.presence || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Peso</span>
          <div class="form-control"><%= @trip.weight ? "#{@trip.weight} Kg" : "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Tarifa</span>
          <div class="form-control"><%= @trip.tariff %> $/kg</div>
        </div>
        <div>
          <span class="form-label d-block">Kilómetros</span>
          <div class="form-control"><%= @trip.kilometres ? "#{@trip.kilometres} km" : "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Neto</span>
          <div class="form-control">$&thinsp;<%= number_with_delimiter(@trip.net.to_f.round(2)) %></div>
        </div>
        <div>
          <span class="form-label d-block">Importe con IVA (21%)</span>
          <div class="form-control" style="font-weight:700;color:#3b5bdb">
            $&thinsp;<%= number_with_delimiter(@trip.importeiva.to_f.round(2)) %>
          </div>
        </div>
        <div>
          <span class="form-label d-block">Fecha de inicio</span>
          <div class="form-control"><%= @trip.date&.strftime("%d/%m/%Y") || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Fecha de finalización</span>
          <div class="form-control d-flex align-items-center gap-2">
            <%= render "trips/status_button", trip: @trip %>
          </div>
        </div>
      </div>

      <% if @trip.carta_de_porte.attached? || @trip.factura.attached? %>
        <div class="detail-item detail-item--full" style="border-bottom:none; padding-bottom:0;">
          <span class="detail-label">Documentación</span>
          <div class="d-flex gap-2 flex-wrap mt-1">
            <% if @trip.carta_de_porte.attached? %>
              <%= link_to rails_blob_path(@trip.carta_de_porte, disposition: "inline"),
                    class: "doc-chip", title: @trip.carta_de_porte.filename.to_s,
                    target: "_blank", rel: "noopener noreferrer" do %>
                <i class="bi bi-file-earmark-text"></i> Carta de porte
              <% end %>
            <% end %>
            <% if @trip.factura.attached? %>
              <%= link_to rails_blob_path(@trip.factura, disposition: "inline"),
                    class: "doc-chip", title: @trip.factura.filename.to_s,
                    target: "_blank", rel: "noopener noreferrer" do %>
                <i class="bi bi-file-earmark-invoice"></i> Factura
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_trip_path(@trip), class: "btn-pill-primary" %>
        <%= link_to "Volver al historial", trips_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <%# ── Columna derecha: mapa de ruta ── %>
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-truck"></i></div>
      <h2 class="ui-form-card__title">Ruta del viaje</h2>
    </div>
    <div class="ui-form-card__body" style="padding: 0.75rem 0.75rem 1rem;">

      <% if can_map %>
        <% if ENV['GOOGLE_MAPS_API_KEY'].present? %>
          <iframe
            width="100%"
            height="480"
            style="border:0; border-radius:10px; display:block;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src="<%= embed_src %>">
          </iframe>
          <div class="mt-2">
            <%= link_to google_maps_url, target: "_blank", rel: "noopener noreferrer", class: "btn-pill-secondary" do %>
              <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en Google Maps
            <% end %>
          </div>
        <% else %>
          <div class="map-placeholder" style="min-height:460px; border-radius:10px; flex-direction:column; gap:1rem;">
            <i class="bi bi-map" style="font-size:3.5rem;"></i>
            <p style="font-size:0.85rem; text-align:center; padding:0 1.5rem; margin:0;">
              Configurá <code>GOOGLE_MAPS_API_KEY</code> en <code>.env</code> para ver la ruta embebida.
            </p>
            <%= link_to google_maps_url, target: "_blank", rel: "noopener noreferrer",
                class: "btn-pill-primary", style: "width:auto; padding:0.6rem 1.5rem;" do %>
              <i class="bi bi-truck me-1"></i> Ver ruta en Google Maps
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="map-placeholder" style="min-height:460px; border-radius:10px; flex-direction:column; gap:0.75rem;">
          <i class="bi bi-geo-alt" style="font-size:3.5rem;"></i>
          <p style="font-size:0.85rem; text-align:center; padding:0 1rem; margin:0;">
            Asigná un campo de origen y un destino al viaje para ver la ruta.
          </p>
        </div>
      <% end %>

      <div class="mt-3">
        <span class="form-label d-block mb-2">Documentación</span>
        <div class="trip-docs-section__buttons">
          <% if @trip.factura.attached? %>
            <button type="button"
                    class="upload-btn upload-btn--attached"
                    data-bs-toggle="modal"
                    data-bs-target="#docViewerModal"
                    data-doc-url="<%= rails_blob_path(@trip.factura, disposition: 'inline') %>"
                    data-doc-download-url="<%= rails_blob_path(@trip.factura, disposition: 'attachment') %>"
                    data-doc-name="<%= @trip.factura.filename %>"
                    data-doc-type="<%= @trip.factura.content_type %>">
              <i class="bi bi-file-earmark-invoice"></i>
              <span>Factura</span>
            </button>
          <% else %>
            <button type="button" class="upload-btn" disabled style="opacity:0.4;cursor:not-allowed;">
              <i class="bi bi-file-earmark-invoice"></i>
              <span>Sin Factura</span>
            </button>
          <% end %>

          <% if @trip.carta_de_porte.attached? %>
            <button type="button"
                    class="upload-btn upload-btn--attached"
                    data-bs-toggle="modal"
                    data-bs-target="#docViewerModal"
                    data-doc-url="<%= rails_blob_path(@trip.carta_de_porte, disposition: 'inline') %>"
                    data-doc-download-url="<%= rails_blob_path(@trip.carta_de_porte, disposition: 'attachment') %>"
                    data-doc-name="<%= @trip.carta_de_porte.filename %>"
                    data-doc-type="<%= @trip.carta_de_porte.content_type %>">
              <i class="bi bi-file-earmark-text"></i>
              <span>Carta de Porte</span>
            </button>
          <% else %>
            <button type="button" class="upload-btn" disabled style="opacity:0.4;cursor:not-allowed;">
              <i class="bi bi-file-earmark-text"></i>
              <span>Sin Carta de Porte</span>
            </button>
          <% end %>
        </div>
      </div>
      
    </div>
  </div>

  <%# ── Modal finalización de viaje ── %>
  <div class="modal fade" id="trip-finalize-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content" style="border-radius:16px;border:none">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-semibold">Fecha de finalización</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label" style="color:#3b5bdb;font-weight:500;font-size:.85rem">
            Seleccioná la fecha de finalización
          </label>
          <input type="date"
                 class="form-control"
                 style="background:#f4f6fc;border:none;border-radius:10px"
                 data-trip-status-target="dateInput">
          <input type="hidden" data-trip-status-target="tripId">
          <p class="text-danger mt-2 mb-0" style="font-size:.82rem;display:none"
             data-trip-status-target="error">
            Seleccioná una fecha antes de continuar.
          </p>
        </div>
        <div class="modal-footer border-0 pt-0 flex-column gap-2">
          <button type="button" class="btn-pill-primary" data-action="click->trip-status#confirm">Aceptar</button>
          <button type="button" class="btn-pill-secondary" data-bs-dismiss="modal">Cancelar</button>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── Modal visor de documentos ── %>
<div class="modal fade" id="docViewerModal" tabindex="-1"
     aria-labelledby="docViewerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content" style="border-radius:14px;overflow:hidden;">
      <div class="modal-header" style="border-bottom:1px solid #eee;padding:1rem 1.25rem;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-text" id="docViewerIcon" style="font-size:1.3rem;color:#3b5bdb;"></i>
          <h5 class="modal-title mb-0" id="docViewerModalLabel" style="font-size:1rem;font-weight:600;"></h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body" id="docViewerBody"
           style="padding:0;min-height:520px;background:#f4f4f8;display:flex;align-items:center;justify-content:center;">
        <div class="doc-viewer-loading">
          <div class="spinner-border text-primary" role="status"></div>
        </div>
      </div>
      <div class="modal-footer" style="border-top:1px solid #eee;padding:0.75rem 1.25rem;gap:0.5rem;">
        <a id="docDownloadBtn" href="#"
           class="btn-pill-primary" style="width:auto;padding:0.55rem 1.4rem;font-size:0.9rem;">
          <i class="bi bi-download me-1"></i> Descargar
        </a>
        <button type="button" class="btn-pill-secondary"
                data-bs-dismiss="modal" style="width:auto;padding:0.55rem 1.4rem;font-size:0.9rem;">
          Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const modal = document.getElementById('docViewerModal')
  if (!modal) return

  modal.addEventListener('show.bs.modal', function (event) {
    const btn         = event.relatedTarget
    const url         = btn.dataset.docUrl
    const downloadUrl = btn.dataset.docDownloadUrl
    const name        = btn.dataset.docName
    const type        = btn.dataset.docType || ''

    document.getElementById('docViewerModalLabel').textContent = name
    document.getElementById('docDownloadBtn').href = downloadUrl

    const icon = document.getElementById('docViewerIcon')
    icon.className = type.startsWith('image/') ? 'bi bi-file-earmark-image' : 'bi bi-file-earmark-text'
    icon.style.color = '#3b5bdb'

    const body = document.getElementById('docViewerBody')
    body.innerHTML = '<div class="doc-viewer-loading"><div class="spinner-border text-primary" role="status"></div></div>'

    if (type.startsWith('image/')) {
      const img = document.createElement('img')
      img.src   = url
      img.style.cssText = 'max-width:100%;max-height:75vh;display:block;border-radius:4px;'
      img.onload  = () => { body.innerHTML = ''; body.style.padding = '1rem'; body.appendChild(img) }
      img.onerror = () => { body.innerHTML = '<p style="color:#888;padding:2rem;">No se pudo cargar la imagen.</p>' }
    } else {
      const iframe = document.createElement('iframe')
      iframe.src   = url
      iframe.style.cssText = 'width:100%;height:72vh;border:0;display:block;'
      setTimeout(() => { body.innerHTML = ''; body.appendChild(iframe) }, 120)
    }
  })

  modal.addEventListener('hidden.bs.modal', function () {
    const body = document.getElementById('docViewerBody')
    body.innerHTML = '<div class="doc-viewer-loading"><div class="spinner-border text-primary" role="status"></div></div>'
    body.style.padding = ''
  })
})()
</script>
