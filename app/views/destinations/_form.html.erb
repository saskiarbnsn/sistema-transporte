<%= form_with(model: destination) do |form| %>
  <% if destination.errors.any? %>
    <div class="alert alert-danger mb-3">
      <ul class="mb-0 ps-3">
        <% destination.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ui-form-grid">
    <div>
      <%= form.label :cuit, "CUIT", class: "form-label" %>
      <%= form.text_field :cuit, class: "form-control", placeholder: "Ej: 30-50001234-5",
            inputmode: "numeric",
            data: { controller: "cuit-format", action: "input->cuit-format#format" } %>
    </div>

    <div>
      <%= form.label :name, "Nombre", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: "Ej: Terminal Puerto Rosario" %>
    </div>

    <div class="ui-form-grid--span-2">
      <%= form.label :location, "Ubicación", class: "form-label" %>
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0" style="border:1.5px solid #c8d0e7;border-right:none;border-radius:10px 0 0 10px">
          <i class="bi bi-search text-muted"></i>
        </span>
        <%= form.text_field :location,
              class: "form-control border-start-0",
              placeholder: "Buscá la ubicación con Google Maps...",
              autocomplete: "off",
              style: "border-radius:0 10px 10px 0;border:1.5px solid #c8d0e7;border-left:none",
              data: { "field-map-target": "location search" } %>
      </div>
      <small class="text-muted mt-1 d-block">
        <i class="bi bi-info-circle me-1"></i>Escribí la dirección y seleccioná una sugerencia para ubicar en el mapa.
      </small>
    </div>

    <div>
      <%= form.label :latitude, "Latitud", class: "form-label" %>
      <%= form.text_field :latitude, class: "form-control", placeholder: "Se completa automáticamente",
            data: { "field-map-target": "latitude" } %>
    </div>

    <div>
      <%= form.label :longitude, "Longitud", class: "form-label" %>
      <%= form.text_field :longitude, class: "form-control", placeholder: "Se completa automáticamente",
            data: { "field-map-target": "longitude" } %>
    </div>
  </div>

  <div class="ui-form-actions mt-2">
    <%= form.submit destination.new_record? ? "Guardar destino" : "Actualizar destino", class: "btn-pill-primary" %>
    <%= link_to "Cancelar", destinations_path, class: "btn-pill-secondary" %>
  </div>
<% end %>
