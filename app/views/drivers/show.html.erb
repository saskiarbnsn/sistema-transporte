<% today = Date.current %>
<% trips = Trip.where(driver_id: @driver.id).includes(:field, :destination, :truck).order(date: :desc).limit(50) %>

<div class="form-page">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-person-badge-fill"></i></div>
      <div>
        <h1 class="ui-form-card__title"><%= @driver.name %></h1>
        <p style="margin:0; font-size:0.8rem; color:#888;">CUIT <%= @driver.cuit %></p>
      </div>
    </div>
    <div class="ui-form-card__body">

      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Teléfono</span>
          <span class="detail-value"><%= @driver.phone_number.presence || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Fecha de nacimiento</span>
          <span class="detail-value"><%= @driver.birth_date&.strftime("%d/%m/%Y") || "—" %></span>
        </div>
        <div class="detail-item detail-item--full">
          <span class="detail-label">Domicilio</span>
          <span class="detail-value"><%= @driver.location.presence || "—" %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Apto físico</span>
          <span class="detail-value">
            <% if @driver.apto_vencimiento.nil? %>
              <span class="status-badge status-badge--neutral">Sin fecha</span>
            <% elsif @driver.apto_vencimiento < today %>
              <span class="status-badge status-badge--danger">Vencido <%= @driver.apto_vencimiento.strftime("%d/%m/%Y") %></span>
            <% elsif @driver.apto_vencimiento <= today + 30 %>
              <span class="status-badge status-badge--warning">Vence <%= @driver.apto_vencimiento.strftime("%d/%m/%Y") %></span>
            <% else %>
              <span class="status-badge status-badge--ok">Vigente hasta <%= @driver.apto_vencimiento.strftime("%d/%m/%Y") %></span>
            <% end %>
          </span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Vencimiento licencia</span>
          <span class="detail-value">
            <% if @driver.licencia_vencimiento.nil? %>
              <span class="status-badge status-badge--neutral">Sin fecha</span>
            <% elsif @driver.licencia_vencimiento < today %>
              <span class="status-badge status-badge--danger">Vencida <%= @driver.licencia_vencimiento.strftime("%d/%m/%Y") %></span>
            <% elsif @driver.licencia_vencimiento <= today + 30 %>
              <span class="status-badge status-badge--warning">Vence <%= @driver.licencia_vencimiento.strftime("%d/%m/%Y") %></span>
            <% else %>
              <span class="status-badge status-badge--ok">Vigente hasta <%= @driver.licencia_vencimiento.strftime("%d/%m/%Y") %></span>
            <% end %>
          </span>
        </div>
      </div>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_driver_path(@driver), class: "btn-pill-primary" %>
        <%= link_to "Volver", drivers_path, class: "btn-pill-secondary" %>
      </div>
    </div>
  </div>

  <%= render "trips/related_trips", trips: trips %>
</div>
