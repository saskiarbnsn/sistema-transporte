<%= form_with(model: gasto, data: {
    controller: "gasto-form",
    has_service:              gasto.persisted? && gasto.imputation&.imputation == "Mantenimiento" && gasto.truck.present?,
    original_truck_id:        gasto.truck_id,
    original_truck_plate:     gasto.truck&.plate,
    original_imputation_id:   gasto.imputation_id,
    original_imputation_name: gasto.imputation&.imputation
  }) do |f| %>
  <% if gasto.errors.any? %>
    <div class="form-errors mb-3">
      <i class="bi bi-exclamation-circle-fill form-errors__icon"></i>
      <div class="form-errors__body">
        <p class="form-errors__title">
          <%= gasto.errors.count == 1 ? "1 error" : "#{gasto.errors.count} errores" %> impidieron guardar:
        </p>
        <ul class="form-errors__list">
          <% gasto.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# — Propios —%>
  <div class="mb-4">
    <span class="form-label d-block">Propios</span>
    <div class="ui-radio-group">
      <label>
        <%= f.radio_button :truck_disabled, "true", checked: gasto.truck_disabled?,
              data: { action: "change->gasto-form#propiosChange" } %>
        Sí
      </label>
      <label>
        <%= f.radio_button :truck_disabled, "false", checked: !gasto.truck_disabled?,
              data: { action: "change->gasto-form#propiosChange" } %>
        No
      </label>
    </div>
  </div>

  <%# — Grid de campos —%>
  <div class="ui-form-grid">
    <div>
      <%= f.label :imputation_id, "Imputación", class: "form-label" %>
      <%= f.collection_select :imputation_id, imputations, :id, :imputation,
            { prompt: "Seleccionar" },
            class: "form-select",
            data: { "gasto-form-target": "imputacionSelect",
                    action: "change->gasto-form#imputacionChange" } %>
    </div>
    <div>
      <%= f.label :date, "Fecha", class: "form-label" %>
      <%= f.date_field :date, class: "form-control" %>
    </div>
    <div>
      <%= f.label :supplier, "Proveedor", class: "form-label" %>
      <%= f.text_field :supplier, class: "form-control" %>
    </div>
    <div>
      <%= f.label :description, "Concepto / Descripción", class: "form-label" %>
      <%= f.text_field :description, class: "form-control" %>
    </div>
    <div data-gasto-form-target="truckWrap">
      <%= f.label :truck_id, "Camión", class: "form-label" %>
      <%= f.collection_select :truck_id, Truck.order(:plate), :id, :plate,
            { include_blank: "Seleccionar" },
            class: "form-select",
            data: { "gasto-form-target": "truckSelect" } %>
    </div>
    <div data-gasto-form-target="adelantosWrap">
      <%= f.label :adelantos, "Adelantos", class: "form-label" %>
      <%= f.text_field :adelantos, class: "form-control",
            disabled: true,
            data: { "gasto-form-target": "adelantosInput" } %>
    </div>
    <div class="d-none" data-gasto-form-target="litrosWrap">
      <%= f.label :litros, "Litros", class: "form-label" %>
      <%= f.number_field :litros, class: "form-control", min: 0,
            data: { "gasto-form-target": "litrosInput" } %>
    </div>
  </div>

  <%# — Importe total —%>
  <div class="gasto-totals">
    <div class="gasto-totals__left">
      <p class="gasto-totals__title">Importe Total</p>
      <%= f.number_field :total, class: "gasto-total-input",
            step: "0.01", min: 0, placeholder: "$ 0,00",
            data: { "gasto-form-target": "total", action: "input->gasto-form#calculate" } %>
    </div>
    <div class="gasto-totals__breakdown">
      <div class="gasto-totals__col">
        <span class="gasto-totals__col-label">Neto</span>
        <span class="gasto-totals__col-value" data-gasto-form-target="netoDisplay">$ 0,00</span>
      </div>
      <div class="gasto-totals__sep"></div>
      <div class="gasto-totals__col">
        <span class="gasto-totals__col-label">IVA</span>
        <span class="gasto-totals__col-value" data-gasto-form-target="ivaDisplay">$ 0,00</span>
      </div>
      <div class="gasto-totals__sep"></div>
      <div class="gasto-totals__col">
        <span class="gasto-totals__col-label">Gravado</span>
        <span class="gasto-totals__col-value" data-gasto-form-target="gravadoDisplay">$ 0,00</span>
      </div>
    </div>
  </div>

  <%# — Acciones —%>
  <div class="ui-form-actions">
    <button type="submit" class="btn-pill-primary" data-gasto-form-target="submitBtn">
      <%= gasto.new_record? ? "Confirmar" : "Actualizar" %>
    </button>
    <%= link_to "Cancelar", gastos_path, class: "btn-pill-secondary" %>
  </div>

  <%# — Modal de confirmación de cambios en servicio técnico —%>
  <div class="modal fade" tabindex="-1" data-gasto-form-target="confirmModal">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px">
      <div class="modal-content confirm-card">
        <div class="confirm-card__inner">
          <div class="confirm-card__icon confirm-card__icon--warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <h5 class="confirm-card__title">¿Estás seguro?</h5>
          <p class="confirm-card__msg">Los siguientes campos cambiarán:</p>
          <ul class="confirm-card__list" data-gasto-form-target="changeList"></ul>
          <div class="confirm-card__alert confirm-card__alert--danger" data-gasto-form-target="impactMsg"></div>
          <div class="confirm-card__actions">
            <button type="button" class="confirm-card__btn confirm-card__btn--cancel" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="confirm-card__btn confirm-card__btn--confirm" data-action="click->gasto-form#doConfirm">Confirmar</button>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
