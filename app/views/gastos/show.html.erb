<div class="form-page form-page--single">
  <div class="ui-form-card">
    <div class="ui-form-card__header">
      <div class="ui-form-card__badge"><i class="bi bi-receipt-cutoff"></i></div>
      <h1 class="ui-form-card__title">Detalle del gasto</h1>
    </div>
    <div class="ui-form-card__body">

      <div class="ui-form-grid">
        <div>
          <span class="form-label d-block">Fecha</span>
          <div class="form-control"><%= @gasto.date&.strftime("%d/%m/%Y") || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Categoría</span>
          <div class="form-control"><%= @gasto.imputation&.imputation || "—" %></div>
        </div>
        <div class="ui-form-grid--span-2">
          <span class="form-label d-block">Proveedor</span>
          <div class="form-control"><%= @gasto.supplier.presence || "—" %></div>
        </div>
        <div class="ui-form-grid--span-2">
          <span class="form-label d-block">Descripción</span>
          <div class="form-control"><%= @gasto.description.presence || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Camión</span>
          <div class="form-control"><%= @gasto.truck&.plate || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Chofer</span>
          <div class="form-control"><%= @gasto.driver&.name || "—" %></div>
        </div>
        <div>
          <span class="form-label d-block">Gravado (sin IVA)</span>
          <div class="form-control">$&thinsp;<%= number_with_delimiter(@gasto.gravado.to_f.round(2)) %></div>
        </div>
        <div>
          <span class="form-label d-block">IVA (21%)</span>
          <div class="form-control">$&thinsp;<%= number_with_delimiter(@gasto.iva.to_f.round(2)) %></div>
        </div>
        <div class="ui-form-grid--span-2">
          <span class="form-label d-block">Total con IVA</span>
          <div class="form-control" style="font-size:1.1rem;font-weight:700;color:#1a1a2e">
            $&thinsp;<%= number_with_delimiter(@gasto.total.to_f.round(2)) %>
          </div>
        </div>
      </div>

      <div class="ui-form-actions">
        <%= link_to "Editar", edit_gasto_path(@gasto), class: "btn-pill-primary" %>
        <%= link_to "Volver", gastos_path, class: "btn-pill-secondary" %>
      </div>

    </div>
  </div>
</div>
