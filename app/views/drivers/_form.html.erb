<%= form_with(model: driver) do |form| %>
  <% if driver.errors.any? %>
    <div class="form-errors">
      <i class="bi bi-exclamation-circle-fill form-errors__icon"></i>
      <div class="form-errors__body">
        <p class="form-errors__title"><%= driver.errors.count == 1 ? "1 error" : "#{driver.errors.count} errores" %> impidieron guardar:</p>
        <ul class="form-errors__list">
          <% driver.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
        </ul>
      </div>
    </div>
  <% end %>
  <div class="ui-form-grid">
    <div><%= form.label :cuit, "CUIT", class: "form-label" %><%= form.text_field :cuit, class: "form-control", inputmode: "numeric", placeholder: "20-12345678-9", oninput: "var d=this.value.replace(/[^0-9]/g,'').slice(0,11);this.value=d.length<=2?d:d.length<=10?d.slice(0,2)+'-'+d.slice(2):d.slice(0,2)+'-'+d.slice(2,10)+'-'+d.slice(10)" %></div>
    <div><%= form.label :phone_number, "Teléfono", class: "form-label" %><%= form.text_field :phone_number, class: "form-control" %></div>
    <div><%= form.label :name, "Nombre completo", class: "form-label" %><%= form.text_field :name, class: "form-control" %></div>
    <div><%= form.label :location, "Domicilio", class: "form-label" %><%= form.text_field :location, class: "form-control", data: { "field-map-target": "location" } %></div>
    <div><%= form.label :birth_date, "Fecha de nacimiento", class: "form-label" %><%= form.date_field :birth_date, class: "form-control" %></div>
    <div>
      <span class="form-label d-block">Apto Físico</span>
      <div class="ui-radio-group mt-1">
        <label><%= form.radio_button :aptofisico, true %> Sí</label>
        <label><%= form.radio_button :aptofisico, false %> No</label>
      </div>
    </div>
    <div><%= form.label :licencia_vencimiento, "Venc. licencia", class: "form-label" %><%= form.date_field :licencia_vencimiento, class: "form-control" %></div>
    <div><%= form.label :apto_vencimiento, "Venc. apto físico", class: "form-label" %><%= form.date_field :apto_vencimiento, class: "form-control" %></div>
  </div>
  <%= form.hidden_field :latitude,  data: { "field-map-target": "latitude" } %>
  <%= form.hidden_field :longitude, data: { "field-map-target": "longitude" } %>

  <div class="ui-form-actions">
    <%= form.submit "Continuar", class: "btn-pill-primary" %>
    <%= link_to "Cancelar", drivers_path, class: "btn-pill-secondary" %>
  </div>
<% end %>
