<div class="dash-panel" data-controller="trip-status table-sort table-filter table-pagination"
     data-action="table-filter:filtered->table-pagination#resetPage table-sort:sorted->table-pagination#resetPage">
  <div class="dash-panel__header">
    <h2 class="dash-panel__title" style="font-size:.95rem">
      <i class="bi bi-map-fill"></i>
      Viajes
      <span class="dash-count"><%= trips.size %></span>
    </h2>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <div class="position-relative">
        <i class="bi bi-search position-absolute" style="left:.65rem;top:50%;transform:translateY(-50%);color:#aaa;font-size:.8rem;pointer-events:none"></i>
        <input type="text"
               class="form-control form-control-sm"
               placeholder="Buscar..."
               data-table-filter-target="input"
               data-action="input->table-filter#filter"
               style="width:180px;padding-left:2rem;border-radius:8px;background:#f4f6fc;border:none;font-size:.82rem">
      </div>
      <%= link_to trips_path, class: "btn-pill-secondary",
            style: "width:auto;padding:.4rem 1rem;font-size:.8rem;white-space:nowrap" do %>
        <i class="bi bi-list me-1"></i>Ver todos
      <% end %>
    </div>
  </div>

  <% if trips.any? %>
    <table class="dash-table">
      <thead>
        <tr>
          <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Fecha <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
          <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Origen <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
          <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Destino <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
          <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Producto <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
          <th data-sortable data-action="click->table-sort#sort" style="cursor:pointer;user-select:none">Estado <i class="sort-caret bi bi-caret-down-fill" style="font-size:.6rem;opacity:.3;margin-left:3px"></i></th>
        </tr>
      </thead>
      <tbody>
        <% trips.each do |trip| %>
          <tr class="dash-table__row"
              data-table-filter-target="row"
              data-table-pagination-target="row"
              onclick="window.location='<%= trip_path(trip) %>'"
              style="cursor:pointer">
            <td style="white-space:nowrap"><%= trip.date&.strftime("%d/%m/%Y") %></td>
            <td><%= trip.field&.name || trip.customer&.name %></td>
            <td><%= trip.destination&.name %></td>
            <td><%= trip.product %></td>
            <td onclick="event.stopPropagation()">
              <%= render "trips/status_button", trip: trip %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div data-table-pagination-target="nav"></div>
  <% else %>
    <div class="text-center py-4">
      <i class="bi bi-map" style="font-size:1.75rem;color:#ccc;display:block;margin-bottom:.5rem"></i>
      <span class="text-muted" style="font-size:.875rem">No hay viajes registrados.</span>
    </div>
  <% end %>

  <%# Modal para finalizar viaje %>
  <div class="modal fade" id="trip-finalize-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content" style="border-radius:16px;border:none">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-semibold">Fecha de finalización</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label" style="color:#3b5bdb;font-weight:500;font-size:.85rem">
            Seleccioná la fecha de finalización
          </label>
          <input type="date"
                 class="form-control"
                 style="background:#f4f6fc;border:none;border-radius:10px"
                 data-trip-status-target="dateInput">
          <input type="hidden" data-trip-status-target="tripId">
          <p class="text-danger mt-2 mb-0" style="font-size:.82rem;display:none"
             data-trip-status-target="error">
            Seleccioná una fecha antes de continuar.
          </p>
        </div>
        <div class="modal-footer border-0 pt-0 flex-column gap-2">
          <button type="button" class="btn-pill-primary" data-action="click->trip-status#confirm">Aceptar</button>
          <button type="button" class="btn-pill-secondary" data-bs-dismiss="modal">Cancelar</button>
        </div>
      </div>
    </div>
  </div>
</div>
