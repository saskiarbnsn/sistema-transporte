<%= form_with(model: gasto, data: { controller: "gasto-form" }) do |f| %>
  <% if gasto.errors.any? %>
    <div class="alert alert-danger mb-3">
      <ul class="mb-0 ps-3">
        <% gasto.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ui-form-grid">
    <div>
      <%= f.label :date, "Fecha", class: "form-label" %>
      <%= f.date_field :date, class: "form-control" %>
    </div>

    <div>
      <%= f.label :imputation_id, "Categoría", class: "form-label" %>
      <%= f.collection_select :imputation_id, imputations, :id, :imputation,
            { prompt: "Seleccionar categoría" }, class: "form-select" %>
    </div>

    <div class="ui-form-grid--span-2">
      <%= f.label :supplier, "Proveedor", class: "form-label" %>
      <%= f.text_field :supplier, class: "form-control", placeholder: "Ej: YPF, Taller Rodríguez..." %>
    </div>

    <div class="ui-form-grid--span-2">
      <%= f.label :description, "Descripción", class: "form-label" %>
      <%= f.text_area :description, class: "form-control", rows: 2,
            placeholder: "Detalle del gasto..." %>
    </div>

    <div>
      <%= f.label :truck_id, "Camión (opcional)", class: "form-label" %>
      <%= f.collection_select :truck_id, Truck.order(:plate), :id, :plate,
            { include_blank: "Sin asignar" }, class: "form-select" %>
    </div>

    <div>
      <%= f.label :driver_id, "Chofer (opcional)", class: "form-label" %>
      <%= f.collection_select :driver_id, Driver.order(:name), :id, :name,
            { include_blank: "Sin asignar" }, class: "form-select" %>
    </div>

    <div class="ui-form-grid--span-2">
      <label class="form-label">Importe total</label>
      <div class="d-flex gap-3 align-items-start">
        <div style="flex:1">
          <%= f.label :total, "Total (c/ IVA)", class: "form-label" style: "font-size:.8rem;color:#888" %>
          <div class="ui-input-unit">
            <%= f.number_field :total, class: "form-control", step: "0.01", min: 0,
                  placeholder: "0.00",
                  data: { "gasto-form-target": "total", action: "input->gasto-form#calculate" } %>
            <span class="ui-input-unit__label">$</span>
          </div>
        </div>
        <div style="flex:1">
          <label class="form-label" style="font-size:.8rem;color:#888">Gravado (sin IVA)</label>
          <div class="ui-input-unit">
            <%= f.number_field :gravado, class: "form-control", step: "0.01", readonly: true,
                  style: "background:#f4f6fc",
                  data: { "gasto-form-target": "gravado" } %>
            <span class="ui-input-unit__label">$</span>
          </div>
        </div>
        <div style="flex:1">
          <label class="form-label" style="font-size:.8rem;color:#888">IVA (21%)</label>
          <div class="ui-input-unit">
            <%= f.number_field :iva, class: "form-control", step: "0.01", readonly: true,
                  style: "background:#f4f6fc",
                  data: { "gasto-form-target": "iva" } %>
            <span class="ui-input-unit__label">$</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ui-form-actions mt-2">
    <%= f.submit gasto.new_record? ? "Guardar gasto" : "Actualizar gasto", class: "btn-pill-primary" %>
    <%= link_to "Cancelar", gastos_path, class: "btn-pill-secondary" %>
  </div>
<% end %>
